# --- macOS junk ---
.DS_Store
**/.DS_Store

# --- Office temp / working files (not part of the site) ---
~$*
*.xlsx

# --- Heavy raw source assets (masters, not referenced by the site) ---
Projects/
_sheets/

# --- Editor / tooling ---
# .claude/ stays local EXCEPT the installed design skills, which are vendored
# so every machine/session gets the same /impeccable + taste-skill behaviour.
.claude/*
!.claude/skills/
.vscode/
.idea/

# --- Vercel ---
.vercel

# Local env / secrets (never commit)
.env
.env.local
.env.*.local
